<Project Sdk="Godot.NET.Sdk/4.5.1">
  <Import Project=".\local.props" Condition="Exists('.\local.props')" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);RITSU001</NoWarn>
    <ImplicitUsings>true</ImplicitUsings>
    <RootNamespace>GuZhenRen</RootNamespace>
    <PathMap>$(MSBuildProjectDirectory)\=.\</PathMap>
    <NoWarn>$(NoWarn);MSB3270;CS0436</NoWarn>

    <GodotExportPreset>Windows Desktop</GodotExportPreset>
    <Sts2ApiCompat>0.111.0</Sts2ApiCompat>
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
    <ModOutputDir>$(Sts2Dir)\mods\$(MSBuildProjectName)\</ModOutputDir>
    <ModPckPath>$(ModOutputDir)$(MSBuildProjectName).pck</ModPckPath>

    <RitsuLibVersion Condition="'$(RitsuLibVersion)' == ''">0.5.13</RitsuLibVersion>
    <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">true</CopyModOnBuild>
    <RunPckExport Condition="'$(RunPckExport)' == '' and '$(DesignTimeBuild)' != 'true'">true</RunPckExport>
    <RunPckExport Condition="'$(RunPckExport)' == ''">false</RunPckExport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
    <PackageReference Include="Nothing.STS2RitsuLib.ModAnalyzers" Version="0.8.2" PrivateAssets="all" />
    <PackageReference Include="STS2.RitsuLib" Version="$(RitsuLibVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime localization files. Keep them beside the compiled mod DLL. -->
    <LocalizationJson Include="GuZhenRenPersonal\localization\zhs\LocalizationCompatibilityPatch.localization.json" />
    <LocalizationJson Include="GuZhenRenPersonal\localization\eng\LocalizationCompatibilityPatch.localization.json" />
    <LocalizationJson Include="GuZhenRenPersonal\localization\zhs\enchantments.json" />
    <LocalizationJson Include="GuZhenRenPersonal\localization\eng\enchantments.json" />
    <!-- All localization tables are copied beside the DLL so the runtime can
         load them from mods\GuZhenRenPersonal\GuZhenRenPersonal\localization. -->
    <RuntimeLocalizationJson Include="GuZhenRenPersonal\localization\**\*.json" />

    <None Update="GuZhenRenPersonal\localization\zhs\LocalizationCompatibilityPatch.localization.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="GuZhenRenPersonal\localization\eng\LocalizationCompatibilityPatch.localization.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="GuZhenRenPersonal\localization\zhs\enchantments.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="GuZhenRenPersonal\localization\eng\enchantments.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)\0Harmony.dll" Private="True" />
    <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="True" />
    <Reference Include="Steamworks.NET" HintPath="$(Sts2DataDir)\Steamworks.NET.dll" Private="True" />
  </ItemGroup>

  <ItemGroup>
    <!-- Godot resources are packed into the PCK; explicitly listed C# scene scripts are compiled here. -->
    <Compile Remove=".godot/**;.idea/**;.vs/**;.build/**;src/**;Slay the Spire 2/**;bin/**;obj/**;GuZhenRenPersonal/**;GuZhenRenPersonalCode/Cards/Basic/ShaZhaoTuiYan.cs;GuZhenRenPersonalCode/Patch/ShaZhaoTuiYanPatch.cs" />
    <EmbeddedResource Remove=".godot/**;.idea/**;.vs/**;.build/**;src/**;Slay the Spire 2/**;bin/**;obj/**;GuZhenRenPersonal/**" />
    <None Remove=".godot/**;.idea/**;.vs/**;.build/**;src/**;Slay the Spire 2/**;bin/**;obj/**" />

    <Compile Include="GuZhenRenPersonal/scenes/ui/nodes/GuZhenRenEnergyCounter.cs"
             Condition="Exists('GuZhenRenPersonal/scenes/ui/nodes/GuZhenRenEnergyCounter.cs')" />

    <!-- Target-rotation energy counter controller. -->
    <Compile Include="GuZhenRenPersonal/scenes/ui/nodes2/GuZhenRenEnergyCounterController2.cs"
             Condition="Exists('GuZhenRenPersonal/scenes/ui/nodes2/GuZhenRenEnergyCounterController2.cs')" />

    <AdditionalFiles Include="GuZhenRenPersonal/localization/**/*.json" />
  </ItemGroup>

  <Target Name="ValidateSts2GameInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')"
           Text="Could not find sts2.dll under '$(Sts2DataDir)'. Copy local.props.template to local.props and set Sts2Dir/Sts2DataDir." />
  </Target>

  <Target Name="CopyMod" AfterTargets="Build" Condition="'$(CopyModOnBuild)' != 'false'">
    <MakeDir Directories="$(ModOutputDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ModOutputDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\$(MSBuildProjectName).json"
          DestinationFolder="$(ModOutputDir)"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(ModOutputDir)GuZhenRenPersonal\localization\" />
    <Copy SourceFiles="@(RuntimeLocalizationJson)"
          DestinationFiles="@(RuntimeLocalizationJson->'$(ModOutputDir)GuZhenRenPersonal\localization\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ExportPCK" AfterTargets="Build"
          Condition="'$(RunPckExport)' == 'true' and '$(STS2_SKIP_PCK_EXPORT)' != '1'">
    <Error Condition="'$(GodotExe)' == '' or !Exists('$(GodotExe)')"
           Text="GodotExe is required for PCK export. Copy local.props.template to local.props and set GodotExe, or build with /p:RunPckExport=false." />
    <MakeDir Directories="$(ModOutputDir)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="&quot;$(GodotExe)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;$(GodotExportPreset)&quot; &quot;$(ModPckPath)&quot;"
          EnvironmentVariables="STS2_SKIP_PCK_EXPORT=1" />
  </Target>
</Project>
