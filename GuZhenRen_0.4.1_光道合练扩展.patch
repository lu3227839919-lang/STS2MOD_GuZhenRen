+            this,
+            target,
+            DynamicVars[typeof(ZhaoPoPower).Name].IntValue
+        );
+        await PowerCmd.Apply<JuGuangPower>(
+            choiceContext,
+            Owner.Creature,
+            DynamicVars["LightBonus"].IntValue,
+            Owner.Creature,
+            this
+        );
+    }
+
+    protected override void OnUpgrade()
+    {
+        EnergyCost.UpgradeBy(-1);
+        DynamicVars.Block.UpgradeValueBy(4m);
+    }
+}
